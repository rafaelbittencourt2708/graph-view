# Local development: use your own GitHub login
#   GITHUB_TOKEN=$(gh auth token) npm run dev
GITHUB_TOKEN=

# Production: the GitHub App (read-only Contents). Takes precedence over GITHUB_TOKEN.
GITHUB_APP_ID=
# Either the PEM contents (newlines may be written as \n) or a path to the .pem file
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=

# Protects /admin (creating and turning off links). Required in production.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Where share links are stored. On Railway, mount a volume at /data.
DATABASE_PATH=./data/brain-graph.db

# How often (seconds) a map checks GitHub for a newer commit
REF_TTL_SECONDS=60
PORT=3000
